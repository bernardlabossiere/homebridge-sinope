{
  "private": false,
  "displayName": "Homebridge Sinope with configurable temperature",
  "name": "homebridge-sinope-devices",
  "version": "1.0.5",
  "description": "Unofficial Homebridge plugin for Sinope/Neviweb thermostats with configurable min/max temperature. Fork of homebridge-sinope by frobichaud.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bernardlabossiere/homebridge-sinope.git"
  },
  "bugs": {
    "url": "https://github.com/bernardlabossiere/homebridge-sinope/issues"
  },
  "engines": {
    "node": ">=14.18.1",
    "homebridge": ">=1.3.5"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homekit",
    "sinope",
    "sinope",
    "neviweb",
    "thermostat",
    "baseboard heater",
    "electric heating",
    "anti-frost",
    "chauffage electrique"
  ],
  "dependencies": {
    "async-await-queue": ">=2.1.4",
    "async-lock": "^1.4.0",
    "axios": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^16.10.9",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "homebridge": "^1.3.5",
    "nodemon": "^2.0.20",
    "rimraf": "^3.0.2",
    "ts-node": "^10.3.0",
    "typescript": "^4.4.4"
  },
  "author": "Bernard Labossiere",
  "contributors": [
    {
      "name": "frobichaud",
      "url": "https://github.com/frobichaud",
      "note": "Original author of homebridge-sinope"
    }
  ],
  "homepage": "https://github.com/bernardlabossiere/homebridge-sinope#readme"
}
