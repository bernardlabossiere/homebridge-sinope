{
  "pluginAlias": "Sinope",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "url": {
        "title": "URL",
        "description": "URL of the Neviweb API",
        "type": "string",
        "required": true,
        "default": "https://neviweb.com/api"
      },
      "username": {
        "title": "Username",
        "description": "Username on the Neviweb platform",
        "type": "string",
        "required": true
      },
      "password": {
        "title": "Password",
        "description": "Password on the Neviweb platform",
        "type": "string",
        "required": true
      },
      "locationid": {
        "title": "Location ID",
        "description": "Optional Location ID shown on neviweb website locations/number",
        "type": "string",
        "required": false,
        "default": ""
      },
      "minTemperature": {
        "title": "Minimum Temperature",
        "description": "Minimum target temperature allowed in HomeKit (default: 7.5\u00b0C)",
        "type": "number",
        "required": false,
        "default": 7.5
      },
      "maxTemperature": {
        "title": "Maximum Temperature",
        "description": "Maximum target temperature allowed in HomeKit (default: 30\u00b0C)",
        "type": "number",
        "required": false,
        "default": 30
      }
    }
  }
}